{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "900px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "darkest",
					"name": "Darkest",
					"color": "#262626"
				},
				{
					"slug": "darker",
					"name": "Darker",
					"color": "#4d4d4d"
				},
				{
					"slug": "dark",
					"name": "Dark",
					"color": "#808080"
				},
				{
					"slug": "light",
					"name": "Light",
					"color": "#b3b3b3"
				},
				{
					"slug": "lighter",
					"name": "Lighter",
					"color": "#d9d9d9"
				},
				{
					"slug": "lightest",
					"name": "Lightest",
					"color": "#ffffff"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#3399cc"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#ff9933"
				},
				{
					"slug": "tertiary",
					"name": "Tertiary",
					"color": "#99cc33"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"units": [
				"px", "rem"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "sans-serif",
					"name": "Sans Serif",
					"fontFamily": "\"Noto Sans JP\", \"Yu Gothic\", sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Noto Serif JP\", \"Yu Mincho\", serif"
				},
				{
					"slug": "system-font",
					"name": "System Font",
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "var(--wp--custom--font-size--small)"
				},
				{
					"slug": "medium",
					"size": "var(--wp--custom--font-size---medium)"
				},
				{
					"slug": "large",
					"size": "var(--wp--custom--font-size-large)"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.5rem, 4vw, 3rem)"
				}
			],
			"dropCap": false
		},
		"custom": {
			"spacing": {
				"container-pad": "clamp(0.75rem, 2%, 1rem)",
				"container-pad-wide": "clamp(0.75rem, 2%, 1.5rem)",
				"none": "0",
				"x-small": "0.375rem",
				"small": "0.75rem",
				"medium": "1.5rem",
				"large": "3rem",
				"x-large": "6rem"
			},
			"font-size": {
				"small": "0.875rem",
				"normal": "1rem",
				"medium": "1.125rem",
				"large": "1.25rem",
				"x-large": "1.5rem"
			},
			"line-height": {
				"x-small": "1.2",
				"small": "1.4",
				"medium": "1.6",
				"large": "1.8",
				"x-large": "2"
			},
			"letter-spacing": {
				"medium": "0",
				"large": "0.02em",
				"x-large": "0.04em"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--darkest)"
		},
		"spacing": {
			"blockGap": "0"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans-serif)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--large)",
			"letterSpacing": "var(--wp--custom--letter-spacing--large)"
		},
		"blocks": {
			"core/heading": {
				"spacing": {
					"margin": {
						"top": "var(--wp--custom--spacing--medium)",
						"bottom": "var(--wp--custom--spacing--small)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans-serif)",
					"lineHeight": "var(--wp--custom--line-height--x-small)"
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "var(--wp--custom--spacing--small)",
						"bottom": "var(--wp--custom--spacing--small)"
					}
				}
			},
			"core/list": {
				"spacing": {
					"margin": {
						"top": "var(--wp--custom--spacing--small)",
						"bottom": "var(--wp--custom--spacing--small)"
					}
				}
			},
			"core/list-item": {
				"spacing": {
					"margin": {
						"top": "var(--wp--custom--spacing--small)",
						"bottom": "var(--wp--custom--spacing--small)"
					}
				}
			},
			"core/image": {
				"spacing": {
					"margin": {
						"top": "var(--wp--custom--spacing--small)",
						"bottom": "var(--wp--custom--spacing--small)"
					}
				}
			},
			"core/table": {
				"spacing": {
					"margin": {
						"top": "var(--wp--custom--spacing--small)",
						"bottom": "var(--wp--custom--spacing--small)"
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var(--wp--custom--font-size--small)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--custom--font-size--small)"
				}
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontWeight": "400",
					"fontSize": "var(--wp--custom--font-size--x-large)"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "400",
					"fontSize": "var(--wp--custom--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontWeight": "400",
					"fontSize": "var(--wp--custom--font-size--medium)"
				}
			},
			"h4": {
				"typography": {
					"fontWeight": "400",
					"fontSize": "var(--wp--custom--font-size--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--custom--font-size--normal)"
				}
			},
			"h6": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--custom--font-size--normal)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--darker)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "g-nav",
			"title": "G Nav"
		},
		{
			"name": "section-hero",
			"title": "Section Hero"
		},
		{
			"name": "section-about",
			"title": "Section About"
		},
		{
			"name": "section-news",
			"title": "Section News"
		},
		{
			"name": "section-access",
			"title": "Section Access"
		},
		{
			"name": "section-contact",
			"title": "Section Contact"
		},
		{
			"name": "sidebar",
			"title": "Sidebar"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
